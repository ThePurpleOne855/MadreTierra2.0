---
import Layout from '../layouts/Layout.astro'
import LocationsGrid from '../components/LocationsGrid.jsx'

// Import all location images (resolved to build-time URLs, computed once at build).
const locationImagesAvif = import.meta.glob('../Locations/*.avif', { eager: true, query: '?url', import: 'default' })
const locationImagesJpg = import.meta.glob('../Locations/*.jpg', { eager: true, query: '?url', import: 'default' })
const locationImages = { ...locationImagesAvif, ...locationImagesJpg }

// Capitalize first letter of each word
const capitalizeWords = (str) => {
  if (!str) return str
  return str
    .split(' ')
    .map((word) => {
      const hasComma = word.endsWith(',')
      const cleanWord = word.replace(/[,.]/g, '')

      if (cleanWord.length === 1 && /^[NSEW]$/i.test(cleanWord)) {
        return cleanWord.toUpperCase() + (hasComma ? ',' : '')
      }
      if (cleanWord.length === 2 && /^[A-Z]{2}$/i.test(cleanWord)) {
        return cleanWord.toUpperCase() + (hasComma ? ',' : '')
      }
      const uppercaseAbbreviations = ['ecl', 'pbr']
      if (uppercaseAbbreviations.includes(cleanWord.toLowerCase())) {
        return cleanWord.toUpperCase() + (hasComma ? ',' : '')
      }
      if (cleanWord.includes("'")) {
        const parts = cleanWord.split("'")
        const result =
          parts[0].charAt(0).toUpperCase() +
          parts[0].slice(1).toLowerCase() +
          "'" +
          (parts[1] ? parts[1].charAt(0).toUpperCase() + parts[1].slice(1).toLowerCase() : '')
        return result + (hasComma ? ',' : '')
      }
      const abbreviations = ['rd', 'st', 'ave', 'pkwy', 'ste', 'blvd', 'ct', 'dr', 'ln', 'pl', 'way']
      if (abbreviations.includes(cleanWord.toLowerCase())) {
        return cleanWord.charAt(0).toUpperCase() + cleanWord.slice(1).toLowerCase() + (hasComma ? ',' : '')
      }
      return cleanWord.charAt(0).toUpperCase() + cleanWord.slice(1).toLowerCase() + (hasComma ? ',' : '')
    })
    .join(' ')
}

// Parse filename to extract store name and location
const parseLocationInfo = (filename) => {
  const nameWithoutExt = filename.replace(/\.(avif|jpg)$/i, '')

  if (nameWithoutExt.includes(' - ')) {
    const parts = nameWithoutExt.split(' - ')
    return {
      name: capitalizeWords(parts[0].trim()),
      location: capitalizeWords(parts[1].trim()),
    }
  }

  if (/^\d/.test(nameWithoutExt)) {
    return {
      name: 'Retail Location',
      location: capitalizeWords(nameWithoutExt.trim()),
    }
  }

  const match = nameWithoutExt.match(/^(.+?)\s+(\d.+)$/)
  if (match) {
    return {
      name: capitalizeWords(match[1].trim()),
      location: capitalizeWords(match[2].trim()),
    }
  }

  return {
    name: capitalizeWords(nameWithoutExt.trim()),
    location: '',
  }
}

const locationFiles = [
  'Cigar Castle 11724 N 56th st, tampa, FL 33617.avif',
  'ECL Eiland Cigar Lounge  & Liquor - 37130 Eiland Blvd, Zephyrhills, FL 33542.jpg',
  'Ash cigar lounge - 92 NH-125, Kingston, NH 03848.avif',
  "Castro's back room - 132 Bedford center rd ste b, bedford, NH 03110.avif",
  "Castro's Back Room - 972 Elm St, manchester, NH 03101.avif",
  'F & M cigars - 503 14th st, phenix city, AL 36867.avif',
  "Grumpy's cigars and lounge - 29 Lowell Rd Hudson, NH 03051.avif",
  'PBR miami country bar.avif',
  'Smoke rings 72 cigar & pipe - 925 N Courtenay Pkwy Merritt Island, FL 32953.avif',
  'Stogies & Stories: Cigars, Spirits, and Friends - 3920 W 5th Ave Suite A1, Post Falls, ID 83854.jpg',
  'The Cigar Quarters - 344 E Main St, Haines City, FL 33844.avif',
  'The office cigars Lounge - 36 S Atlantic ave cocoa Beach, FL 32831.avif',
  'Tobacco shack - 162 Newburyport Turnpike, Rowley, MA 01969.avif',
  'two guys smoke shop - 741 lafayette rd, seabrook, NH 03874.avif',
  'two guys smoke shop 304 S. broadway, salem, NH 03079.avif',
]

// Address mapping for locations that don't have addresses in filename
const addressMapping = {
  'PBR miami country bar.avif': 'Dolphin Mall, 11401 NW 12th St, Miami, FL 33172',
}

const locations = locationFiles.map((file) => {
  const info = parseLocationInfo(file)
  if (!info.location && addressMapping[file]) {
    info.location = capitalizeWords(addressMapping[file])
  }
  const imagePath = locationImages[`../Locations/${file}`] || ''
  return { ...info, image: imagePath }
})

const getStateFromLocation = (location) => {
  const stateMatch = location.match(/\b([A-Z]{2})\s+\d{5}\b/)
  return stateMatch ? stateMatch[1] : null
}

const states = [...new Set(locations.map((loc) => getStateFromLocation(loc.location)).filter(Boolean))].sort()
---

<Layout
  title="Find a Retailer | MadreTierra Cigars Locations"
  description="Find MadreTierra Cigars at authorized premium retailers and lounges near you. Visit our network of locations across multiple states to experience our handcrafted cigars."
  keywords="cigar retailers, cigar shops, cigar lounges, find cigars near me, MadreTierra locations, authorized cigar retailers, cigar stores, premium cigar retailers"
  path="/locations"
>
  <section class="py-24 bg-light min-h-screen">
    <div class="max-w-7xl mx-auto px-5">
      <div class="text-center mb-16">
        <span class="leaf-rule mx-auto mb-5" />
        <h1 class="text-5xl md:text-6xl font-serif font-bold text-primary mb-4">
          Retail locations
        </h1>
        <p class="text-xl text-dark/70 max-w-2xl mx-auto leading-relaxed">
          Find MadreTierra Cigars at authorized retailers near you. Visit these premium locations to experience our handcrafted excellence.
        </p>
      </div>

      <LocationsGrid client:load locations={locations} states={states} />

      <div class="mt-20 text-center">
        <div class="bg-gradient-to-br from-primary to-dark rounded-2xl p-12 text-light">
          <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">
            Can't find a location?
          </h2>
          <p class="text-xl text-secondary mb-8 max-w-2xl mx-auto">
            Contact us to learn more about becoming an authorized retailer or finding locations near you.
          </p>
          <a href="/#about" class="btn-solid">
            Contact us
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
