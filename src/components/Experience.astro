---
import craftsmanshipImg from '../ExperiencePictures/Craftmanship.jpeg'
import premiumTobaccoImg from '../ExperiencePictures/PremiumTobacoPicture.jpeg'
import excellenceImg from '../ExperiencePictures/Experience Picture.jpeg'

const experiences = [
  {
    image: craftsmanshipImg.src,
    title: 'Craftsmanship',
    description: 'Every cigar is hand-rolled by master artisans with decades of experience.',
  },
  {
    image: premiumTobaccoImg.src,
    title: 'Premium Tobacco',
    description: "Sourced from the world's finest growing regions and aged to perfection.",
  },
  {
    image: excellenceImg.src,
    title: 'Excellence',
    description: 'Uncompromising quality in every blend, every wrapper, every draw.',
  },
]
---

<section id="experience" class="py-24 bg-light">
  <div class="max-w-7xl mx-auto px-5">
    <span class="leaf-rule mx-auto mb-5" />
    <h2 class="text-4xl md:text-6xl font-serif font-bold text-primary text-center mb-16">
      The Madre Tierra experience
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {experiences.map((exp) => (
        <div class="text-center">
          <div class="mb-6 overflow-hidden rounded-2xl shadow-md">
            <img src={exp.image} alt={exp.title} class="w-full h-56 object-cover" />
          </div>
          <h3 class="text-2xl font-serif font-bold text-primary mb-3">
            {exp.title}
          </h3>
          <p class="text-dark/80 leading-relaxed">
            {exp.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
