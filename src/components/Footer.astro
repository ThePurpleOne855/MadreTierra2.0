---
import logoImageMeta from '../logo/Madre-Tierra-Logo.png'
import veteranLogoMeta from '../logo/VeteranOwnedBusinessLogo.png'
import dominicanFlagMeta from '../logo/DominicanFlagTransparent.png'

const logoImage = logoImageMeta.src
const veteranLogo = veteranLogoMeta.src
const dominicanFlag = dominicanFlagMeta.src

const footerSections = [
  {
    title: 'Explore',
    links: [
      { href: '/selection', label: 'Cigar Selection' },
      { href: '/#about', label: 'About Us' },
      { href: '/#where-to-buy', label: 'Where To Buy' },
      { href: '/locations', label: 'Locations' },
      { href: '/#experience', label: 'Experience' },
    ],
  },
  {
    title: 'Connect',
    links: [
      { href: '/#contact', label: 'Contact Us' },
      { href: '/#experience', label: 'Events' },
      { href: '/#about', label: 'Press' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/#about', label: 'Terms of Use' },
      { href: '/#about', label: 'Privacy Policy' },
      { href: '/#about', label: 'Age Verification' },
    ],
  },
]
---

<footer class="bg-dark py-16 text-light">
  <div class="max-w-7xl mx-auto px-5">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div>
        <img
          src={logoImage}
          alt="MadreTierra Cigars"
          class="h-16 md:h-20 w-auto mb-4 object-contain transition-transform duration-300 hover:scale-105"
          style={{ filter: 'drop-shadow(0 4px 8px rgba(0, 0, 0, 0.4))' }}
          onerror="this.style.display='none'; this.nextElementSibling.style.display='block'"
        />
        <div style={{ display: 'none' }}>
          <h3 class="text-2xl font-serif font-bold text-secondary mb-2">
            MadreTierra
          </h3>
          <span class="text-sm text-light tracking-wider">Cigars</span>
        </div>
        <p class="text-light/70 mt-4 leading-relaxed mb-6">
          Handcrafted excellence in every cigar.
        </p>
        {/* Badge Logos */}
        <div class="flex items-center gap-4">
          <img
            src={veteranLogo}
            alt="Veteran Owned Business"
            class="h-12 md:h-14 w-auto object-contain hover:scale-105 transition-transform duration-300"
            style={{ filter: 'drop-shadow(0 4px 8px rgba(0, 0, 0, 0.4))' }}
          />
          <img
            src={dominicanFlag}
            alt="Dominican Republic"
            class="h-12 md:h-14 w-auto object-contain hover:scale-105 transition-transform duration-300"
            style={{ filter: 'drop-shadow(0 4px 8px rgba(0, 0, 0, 0.4))' }}
          />
        </div>
      </div>
      {footerSections.map((section) => (
        <div>
          <h4 class="text-lg font-serif font-bold text-secondary mb-6">
            {section.title}
          </h4>
          <ul class="space-y-3">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="text-light/70 hover:text-secondary transition-colors duration-300">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="border-t border-secondary/20 pt-8 text-center">
      <p class="text-light/60 mb-4 text-sm">
        &copy; 2025 MadreTierra Cigars. All rights reserved.
      </p>
      <p class="text-light/50 text-xs italic">
        SURGEON GENERAL'S WARNING: Cigar Smoking Can Cause Cancers Of The Mouth And Throat, Even If You Do Not Inhale.
      </p>
    </div>
  </div>
</footer>
