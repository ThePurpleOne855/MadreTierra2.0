# EmailJS Configuration
# These are PUBLIC keys that will be exposed in client-side code
# However, using environment variables helps with configuration management
# and allows different keys for development/production environments

PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
PUBLIC_EMAILJS_VISITOR_TEMPLATE_ID=your_emailjs_visitor_template_id_here

# Note: In Astro, environment variables must be prefixed with PUBLIC_ to be exposed to client-side code
